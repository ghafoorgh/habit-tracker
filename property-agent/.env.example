# ---- Claude (هوش مصنوعی) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (low برای چت سریع و ارزان کافی است)
CLAUDE_EFFORT=low

# ---- پنل مدیریت ----
PORT=3000
ADMIN_USER=admin
# اگر خالی باشد، پنل فقط از همین کامپیوتر (localhost) باز می‌شود
ADMIN_PASSWORD=

# ---- واتس‌اپ ----
WHATSAPP_ENABLED=true
# اگر Chrome پیدا نشد، مسیرش را بدهید. مثال ویندوز: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
# کد کشور برای شماره‌هایی که با 0 شروع می‌شوند (98 ایران، 93 افغانستان، 971 امارات، 90 ترکیه)
DEFAULT_COUNTRY_CODE=98

# ---- محدودیت‌های ضدبن (برای پیام اول به مالکان) ----
DAILY_OUTREACH_LIMIT=30
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=180
SEND_HOUR_START=9
SEND_HOUR_END=20

# ---- اینستاگرام (API رسمی؛ اختیاری) ----
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=یک-رمز-دلخواه
INSTAGRAM_API_VERSION=v21.0
